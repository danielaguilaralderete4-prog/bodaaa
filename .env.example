# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ═══════════════════════════════════════════════════════════════════
#  Lista de Regalos — Bárbara & Daniel 2026
# ═══════════════════════════════════════════════════════════════════

# ─── Mercado Pago ─────────────────────────────────────────────────
# Obtén tu token en: https://www.mercadopago.cl/developers/panel/credentials
# TEST-xxxxx para sandbox, APP_USR-xxxxx para producción
MP_ACCESS_TOKEN=TEST-REEMPLAZA_CON_TU_TOKEN

# Secret para verificar firmas de webhooks (string largo aleatorio)
MP_WEBHOOK_SECRET=REEMPLAZA_CON_UN_SECRET_ALEATORIO

# URL pública del backend donde MP enviará los webhooks
# En local usa ngrok: https://xxxxx.ngrok.io
# En producción: https://tu-app.onrender.com
BACKEND_URL=https://tu-backend-url.com

# ─── Email Notificaciones ─────────────────────────────────────────
NOTIFICATION_EMAIL=danielaguilaralderete4@gmail.com
GMAIL_USER=danielaguilaralderete4@gmail.com
# Crea la contraseña de app en: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ─── Firebase ─────────────────────────────────────────────────────
FIREBASE_DATABASE_URL=https://invitacion--matrimonio-default-rtdb.firebaseio.com
# Para despliegue externo (Render/Railway), pega aquí el JSON del service account en una línea:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ─── Servidor ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Frontend (Vite) ───────────────────────────────────────────────
# URL absoluta del backend cuando frontend y backend están en dominios
# distintos (ej: frontend en Firebase Hosting, backend en Render).
# Se usa al hacer `npm run build`. En desarrollo se deja vacío para que
# el proxy de Vite (/api → localhost:3001) siga funcionando.
VITE_API_BASE_URL=https://tu-backend.onrender.com/api/gifts

