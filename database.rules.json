{
  "rules": {
    "guestDirectory": {
      ".read": true,
      ".write": "auth != null"
    },
    "guests": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "guestResponses": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "giftCatalog": {
      ".read": true,
      ".write": "auth != null"
    },
    "giftOrders": {
      ".read": "auth != null",
      "$orderId": {
        ".write": "auth != null"
      }
    },
    "musicRequests": {
      ".read": true,
      "$requestId": {
        ".write": "!data.exists() || auth != null"
      }
    }
  }
}
