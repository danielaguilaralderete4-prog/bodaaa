{
  "rules": {
    "giftCatalog": {
      ".read": true,
      ".write": "auth != null"
    },
    "giftOrders": {
      ".read": "auth != null",
      "$orderId": {
        ".write": "auth != null"
      }
    },
    "guests": {
      ".read": true,
      ".write": "auth != null"
    },
    "musicRequests": {
      ".read": true,
      ".write": true
    }
  }
}
